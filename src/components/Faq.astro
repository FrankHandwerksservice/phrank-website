---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; heading?: string; }
const { items, heading = 'Fragen?' } = Astro.props;
---
<section id="faq" aria-labelledby="h-faq">
  <div class="faq-grid">
    <h2 id="h-faq">{heading}</h2>
    <div>
      {items.map((f, i) => (
        <details open={i === 0}><summary>{f.q}<Icon name="plus" size={24} /></summary><p>{f.a}</p></details>
      ))}
    </div>
  </div>
</section>
