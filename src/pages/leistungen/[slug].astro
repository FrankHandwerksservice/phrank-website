---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import RefCard from '../../components/RefCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, type Service } from '../../data/services';
import { references } from '../../data/references';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const ref = references.find((r) => r.slug === s.reference);
const others = services.filter((o) => o.slug !== s.slug);
const url = `${site.url}/leistungen/${s.slug}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    description: s.description,
    url,
    provider: { '@id': `${site.url}/#business` },
    areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: s.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={s.title} description={s.description} jsonLd={jsonLd}>
  <main class="wrap">
    <div class="page-hero">
      <nav class="crumb" aria-label="Brotkrumen"><a href="/">Startseite</a><span aria-hidden="true">/</span><a href="/#leistungen">Leistungen</a><span aria-hidden="true">/</span><span aria-current="page">{s.name}</span></nav>
      <h1>{s.h1}</h1>
      <p class="lead">{s.lead}</p>
      <div class="actions">
        <a class="btn btn-marker" href="/#kontakt">Kostenlosen Check anfragen</a>
        <a class="btn btn-ghost" href={`tel:${site.phoneIntl}`}>Anrufen: {site.phone}</a>
      </div>
    </div>

    <section aria-labelledby="h-warum" style="padding-top:clamp(32px,5cqi,64px)">
      <div class="split">
        <h2 id="h-warum">Darum <span class="outline">geht’s.</span></h2>
        <div class="prose">{s.intro.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>

    <section aria-labelledby="h-drin">
      <div class="sec-head"><h2 id="h-drin">Das ist <span class="outline">drin.</span></h2></div>
      <ul class="checks">
        {s.checks.map((c) => <li><span class="ps-ico"><Icon name="check" /></span><div><b>{c.title}</b><span>{c.text}</span></div></li>)}
      </ul>
    </section>

    {ref && (
      <section aria-labelledby="h-beispiel">
        <div class="split">
          <div class="sec-head" style="margin-bottom:0"><h2 id="h-beispiel">Ein <span class="outline">Beispiel.</span></h2><p class="lead">{ref.result}</p></div>
          <RefCard r={ref} />
        </div>
      </section>
    )}

    <Faq items={s.faqs} heading="Fragen?" />

    <section aria-labelledby="h-mehr">
      <div class="sec-head"><h2 id="h-mehr">Passt gut <span class="outline">dazu.</span></h2></div>
      <div class="more-svc">
        {others.map((o) => <a href={`/leistungen/${o.slug}/`}><b>{o.name}</b><span>{o.teaser}</span></a>)}
      </div>
    </section>

    <CtaBand title="Schauen wir uns" outline="deinen Betrieb an?" />
  </main>
</Base>
