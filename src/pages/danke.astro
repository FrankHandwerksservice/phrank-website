---
import Base from '../layouts/Base.astro';
---
<Base title="Danke für deine Anfrage | phrank" description="Deine Anfrage ist angekommen." noindex>
  <main class="wrap">
    <div class="page-hero">
      <h1>Danke! <span class="outline">Ist angekommen.</span></h1>
      <p class="lead">Ich schaue mir deinen Betrieb an und melde mich innerhalb von 24 Stunden bei dir.</p>
      <div class="actions"><a class="btn btn-marker" href="/">Zur Startseite</a></div>
    </div>
  </main>
</Base>
