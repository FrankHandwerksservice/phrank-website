---
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import RefCard from '../../components/RefCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { references, type Reference } from '../../data/references';
import { site } from '../../data/site';

export function getStaticPaths() {
  return references.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: Reference };
const others = references.filter((o) => o.slug !== r.slug);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Referenzen', item: `${site.url}/referenzen/` },
      { '@type': 'ListItem', position: 3, name: r.name, item: `${site.url}/referenzen/${r.slug}/` },
    ],
  },
];
---
<Base
  title={`Referenz ${r.name}: ${r.headline} | phrank`}
  description={`${r.kicker}. ${r.result}`}
  navKey="referenzen"
  jsonLd={jsonLd}
>
  <main class="wrap">
    <div class="ref-hero" style="padding-bottom:0">
      <nav class="crumb" aria-label="Brotkrumen"><a href="/">Startseite</a><span aria-hidden="true">/</span><a href="/referenzen/">Referenzen</a><span aria-hidden="true">/</span><span aria-current="page">{r.name}</span></nav>
    </div>
    <div class="ref-list"><CaseStudy r={r} level="h1" eager /></div>
    <section aria-labelledby="h-weitere">
      <div class="sec-head"><h2 id="h-weitere">Weitere <span class="outline">Arbeiten</span></h2></div>
      <div class="ref-grid">
        {others.map((o) => <RefCard r={o} />)}
      </div>
    </section>
    <CtaBand />
  </main>
</Base>
