---
import Legal from '../layouts/Legal.astro';
import { site } from '../data/site';
---
<Legal title="Impressum | phrank" description="Impressum von phrank, Philipp Frank, Grevenbroich." heading="Impressum">
  <h2>Angaben gemäß § 5 DDG</h2>
  <p>{site.owner}<br />{site.street}<br />{site.zip} {site.city}</p>
  <h2>Kontakt</h2>
  <p>Telefon: <a href={`tel:${site.phoneIntl}`}>{site.phone}</a><br />E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a></p>
  <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
  <p>{site.owner}, Anschrift wie oben</p>
  <h2>Verbraucherstreitbeilegung</h2>
  <p>Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
</Legal>
